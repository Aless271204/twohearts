<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/nido_widget_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="NIDO · Cargando tu widget" />
    <TextView android:id="@+id/nido_widget_edit" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:text="✎" android:gravity="center" android:textColor="#754353" android:textSize="20sp" android:contentDescription="Personalizar este widget" />
    <TextView android:id="@+id/nido_widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="bottom|center_horizontal" android:text="↻" android:gravity="center" android:textColor="#754353" android:textSize="18sp" android:contentDescription="Actualizar nota" android:visibility="gone" />
</FrameLayout>
